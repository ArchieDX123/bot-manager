{
  "name": "bot-manager",
  "productName": "Bot Manager",
  "private": true,
  "version": "2.2.0",
  "description": "Bot Manager: overzicht en beheer van je Grok-assistenten",
  "author": "Bot Manager",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "build": {
    "appId": "app.botmanager.desktop",
    "productName": "Bot Manager",
    "artifactName": "Bot-Manager-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Bot-Manager-Windows-portable.exe"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "Bot-Manager-Mac.dmg"
    },
    "afterPack": "build/adhoc-sign.cjs",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Bot-Manager-Setup.exe",
      "shortcutName": "Bot Manager",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ArchieDX123",
        "repo": "bot-manager",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "45.2.2",
    "electron-builder": "^26.18.0",
    "framer-motion": "^14.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
